# 复制成 .env 再填写；.env 不会上传到 GitHub
# DeepSeek：写脚本（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=

# MiniMax：英文配音 + 看画面给素材打标签
# 国内账号（platform.minimaxi.com）用 https://api.minimaxi.com；海外账号用 https://api.minimax.io
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
# 账户信息页里的 GroupId（部分接口需要，没有可先空着）
MINIMAX_GROUP_ID=

# ---------- 换模型：只改下面这几行，不用动代码 ----------
# 写脚本（SCRIPT_）和成片评测（VIDEO_，要能看图）可以各用各的模型。不填就用 DeepSeek。
# 接口要兼容 OpenAI 的 /chat/completions 格式：DeepSeek、通义千问兼容模式、OpenAI、MiniMax 都是。
# 例：成片评测换成通义千问
#   VIDEO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VIDEO_API_KEY=你的百炼 key
#   VIDEO_MODEL=qwen-vl-plus
SCRIPT_BASE_URL=
SCRIPT_API_KEY=
SCRIPT_MODEL=deepseek-chat
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=deepseek-flash
# 两个环节想用同一家时，也可以只填这两个
LLM_BASE_URL=
LLM_API_KEY=
# 配音用 MiniMax 的哪个语音模型
MINIMAX_TTS_MODEL=speech-2.8-hd

# 成片评测先在本机把配音转成文字（首次使用会下载语音识别模型，small.en 针对英语），再把画面和文字发给上面配置的模型

# 可选：默认 small.en；已缓存多语种 small 时可填 small（仍按英语识别）
WHISPER_MODEL=small.en

# 选题池：连接已运行的 AIHOT（只读取内容，不开启采集或模型任务）
AIHOT_API_URL=http://127.0.0.1:3301
AIHOT_SITE_URL=http://127.0.0.1:3300

# 视频热点接入预留：填写不等于已接通；三个采集器尚未启用
# YouTube Data API：公开搜索与视频统计；与频道私有 Analytics 授权不同
YOUTUBE_API_KEY=
# TikTok / Instagram：取得授权的数据服务地址，具体格式需按供应商对接
VIDEO_TRENDS_TIKTOK_FEED_URL=
VIDEO_TRENDS_INSTAGRAM_FEED_URL=
